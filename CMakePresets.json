{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "desktop-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/cmake/${presetName}",
      "cacheVariables": {
        "ANGLE_BUILD_TESTS": "OFF",
        "ANGLE_BUILD_SAMPLES": "OFF",
        "ANGLE_ENABLE_VULKAN_SECONDARIES": "OFF"
      }
    },
    {
      "name": "desktop-mingw",
      "displayName": "ANGLE desktop (MinGW)",
      "description": "Desktop-only configure preset with MinGW-friendly defaults.",
      "inherits": "desktop-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "ANGLE_ENABLE_D3D9": "OFF",
        "ANGLE_ENABLE_D3D11": "OFF",
        "ANGLE_ENABLE_GL": "ON",
        "ANGLE_ENABLE_VULKAN": "ON",
        "ANGLE_ENABLE_NULL": "ON",
        "ANGLE_ENABLE_WGPU": "OFF"
      }
    },
    {
      "name": "desktop-msvc",
      "displayName": "ANGLE desktop (MSVC)",
      "description": "Desktop-only configure preset for a Visual Studio developer environment.",
      "inherits": "desktop-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "ANGLE_ENABLE_D3D9": "ON",
        "ANGLE_ENABLE_D3D11": "ON",
        "ANGLE_ENABLE_GL": "ON",
        "ANGLE_ENABLE_VULKAN": "ON",
        "ANGLE_ENABLE_NULL": "ON",
        "ANGLE_ENABLE_WGPU": "OFF"
      }
    },
    {
      "name": "desktop-mingw-clang",
      "displayName": "ANGLE desktop (MinGW clang)",
      "description": "Desktop-only configure preset for MSYS2 clang64 with MinGW-style Windows defaults.",
      "inherits": "desktop-mingw",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "desktop-linux",
      "displayName": "ANGLE desktop (Linux)",
      "description": "Desktop-only configure preset for Linux GL and Vulkan work.",
      "inherits": "desktop-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "ANGLE_ENABLE_D3D9": "OFF",
        "ANGLE_ENABLE_D3D11": "OFF",
        "ANGLE_ENABLE_GL": "ON",
        "ANGLE_ENABLE_VULKAN": "ON",
        "ANGLE_ENABLE_METAL": "OFF",
        "ANGLE_ENABLE_NULL": "ON",
        "ANGLE_ENABLE_WGPU": "OFF",
        "ANGLE_USE_X11": "ON",
        "ANGLE_USE_WAYLAND": "OFF",
        "ANGLE_USE_GBM": "OFF"
      }
    },
    {
      "name": "desktop-linux-gbm",
      "displayName": "ANGLE desktop (Linux GBM)",
      "description": "Desktop-only configure preset for Linux GBM/DRM GL and Vulkan work.",
      "inherits": "desktop-linux",
      "cacheVariables": {
        "ANGLE_USE_X11": "OFF",
        "ANGLE_USE_WAYLAND": "OFF",
        "ANGLE_USE_GBM": "ON"
      }
    },
    {
      "name": "desktop-macos",
      "displayName": "ANGLE desktop (macOS)",
      "description": "Desktop-only configure preset for macOS GL, Vulkan, and Metal work.",
      "inherits": "desktop-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "ANGLE_ENABLE_D3D9": "OFF",
        "ANGLE_ENABLE_D3D11": "OFF",
        "ANGLE_ENABLE_GL": "ON",
        "ANGLE_ENABLE_VULKAN": "ON",
        "ANGLE_ENABLE_METAL": "ON",
        "ANGLE_ENABLE_NULL": "ON",
        "ANGLE_ENABLE_WGPU": "OFF"
      }
    }
  ]
}
